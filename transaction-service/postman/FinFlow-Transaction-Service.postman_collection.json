{
  "info": {
    "_postman_id": "e5f6a7b8-c9d0-1234-ef01-345678901234",
    "name": "FinFlow \u2014 Transaction Service",
    "description": "Select environment **FinFlow Local**.\n\nLedger orchestration over wallet balances (saga transfer).\nPrereqs: Identity login with wallets:* + Wallet Create A (/B for transfer).\n\n{{transactionBaseUrl}} = http://localhost:18085\nChange Idempotency-Key vars for each new money move.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "transactionBaseUrl",
      "value": "http://localhost:18085"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "walletId",
      "value": ""
    },
    {
      "key": "walletId2",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "txDepositKey",
      "value": "tx-deposit-001"
    },
    {
      "key": "txWithdrawKey",
      "value": "tx-withdraw-001"
    },
    {
      "key": "txTransferKey",
      "value": "tx-transfer-001"
    }
  ],
  "item": [
    {
      "name": "Money moves",
      "item": [
        {
          "name": "1. Deposit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{txDepositKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{transactionBaseUrl}}/api/v1/transactions/deposits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": {{walletId}},\n  \"amount\": \"100.00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.transactionId != null) { pm.collectionVariables.set('transactionId', String(body.transactionId)); pm.environment.set('transactionId', String(body.transactionId)); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Transfer (saga)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{txTransferKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{transactionBaseUrl}}/api/v1/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": {{walletId}},\n  \"destinationWalletId\": {{walletId2}},\n  \"amount\": \"25.00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.transactionId != null) { pm.collectionVariables.set('transactionId', String(body.transactionId)); pm.environment.set('transactionId', String(body.transactionId)); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Withdraw",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{txWithdrawKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{transactionBaseUrl}}/api/v1/transactions/withdrawals",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": {{walletId}},\n  \"amount\": \"10.00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.transactionId != null) { pm.collectionVariables.set('transactionId', String(body.transactionId)); pm.environment.set('transactionId', String(body.transactionId)); }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "History / ledger",
      "item": [
        {
          "name": "1. Get Transaction",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{transactionBaseUrl}}/api/v1/transactions/{{transactionId}}"
          }
        },
        {
          "name": "2. History by Wallet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{transactionBaseUrl}}/api/v1/transactions?walletId={{walletId}}"
          }
        },
        {
          "name": "3. Ledger Balance (reconcile)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{transactionBaseUrl}}/api/v1/transactions/wallets/{{walletId}}/ledger-balance"
          }
        }
      ]
    }
  ]
}
