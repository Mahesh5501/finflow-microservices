{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "FinFlow \u2014 Wallet Service",
    "description": "Customer folder = shopper UI (CustomerWalletController).\nIntegration folder = commerce checkout/refunds (IntegrationWalletController).\n\nIdentity: Register \u2192 Verify \u2192 Login (JWT needs wallet:read / wallet:write when email is verified).\n\nBearer {{accessToken}} \u00b7 {{walletBaseUrl}} = http://localhost:18082",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "walletBaseUrl",
      "value": "http://localhost:18082"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "accessToken2",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "walletId",
      "value": ""
    },
    {
      "key": "walletId2",
      "value": ""
    },
    {
      "key": "topUpKey",
      "value": "topup-demo-001"
    },
    {
      "key": "depositKey",
      "value": "deposit-demo-001"
    },
    {
      "key": "withdrawKey",
      "value": "withdraw-demo-001"
    }
  ],
  "item": [
    {
      "name": "Customer (customer.api)",
      "description": "CustomerWalletController \u2014 /api/v1/customer/wallet/** (wallet:read / wallet:write)",
      "item": [
        {
          "name": "Open wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.walletId != null) { pm.collectionVariables.set('walletId', String(body.walletId)); pm.environment.set('walletId', String(body.walletId)); }",
                  "  if (body.userId != null) { pm.collectionVariables.set('userId', String(body.userId)); pm.environment.set('userId', String(body.userId)); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"INR\"\n}"
            },
            "url": "{{walletBaseUrl}}/api/v1/customer/wallet"
          }
        },
        {
          "name": "Get my wallet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{walletBaseUrl}}/api/v1/customer/wallet"
          }
        },
        {
          "name": "Top up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{topUpKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"500.00\",\n  \"paymentMethod\": \"UPI\",\n  \"paymentReference\": \"pg-demo-001\"\n}"
            },
            "url": "{{walletBaseUrl}}/api/v1/customer/wallet/top-ups"
          }
        },
        {
          "name": "List my transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{walletBaseUrl}}/api/v1/customer/wallet/transactions"
          }
        }
      ]
    },
    {
      "name": "Integration (integration.api)",
      "description": "IntegrationWalletController \u2014 commerce / ops (same JWT; wallet:write for money moves)",
      "item": [
        {
          "name": "Prerequisites",
          "description": "Open customer wallet first so {{walletId}} is set.",
          "item": [
            {
              "name": "Open wallet B (accessToken2)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200 || pm.response.code === 201) {",
                      "  const body = pm.response.json();",
                      "  if (body.walletId != null) { pm.collectionVariables.set('walletId2', String(body.walletId)); pm.environment.set('walletId2', String(body.walletId)); }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken2}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currency\": \"INR\"\n}"
                },
                "url": "{{walletBaseUrl}}/api/v1/customer/wallet"
              }
            }
          ]
        },
        {
          "name": "Read",
          "item": [
            {
              "name": "Get wallet by user id",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": "{{walletBaseUrl}}/api/v1/users/{{userId}}/wallet"
              }
            },
            {
              "name": "Get wallet by wallet id",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": "{{walletBaseUrl}}/api/v1/wallets/{{walletId}}"
              }
            },
            {
              "name": "List transactions",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": "{{walletBaseUrl}}/api/v1/wallets/{{walletId}}/transactions"
              }
            }
          ]
        },
        {
          "name": "Money moves",
          "item": [
            {
              "name": "Deposit (refund / credit)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Idempotency-Key",
                    "value": "{{depositKey}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": \"100.00\"\n}"
                },
                "url": "{{walletBaseUrl}}/api/v1/wallets/{{walletId}}/deposits"
              }
            },
            {
              "name": "Withdraw (checkout / debit)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Idempotency-Key",
                    "value": "{{withdrawKey}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": \"10.00\"\n}"
                },
                "url": "{{walletBaseUrl}}/api/v1/wallets/{{walletId}}/withdrawals"
              }
            }
          ]
        },
        {
          "name": "Negative cases",
          "item": [
            {
              "name": "No token (401)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{walletBaseUrl}}/api/v1/wallets/{{walletId}}"
              }
            },
            {
              "name": "Invalid currency (400)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currency\": \"XYZ\"\n}"
                },
                "url": "{{walletBaseUrl}}/api/v1/customer/wallet"
              }
            },
            {
              "name": "Insufficient balance (422)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Idempotency-Key",
                    "value": "withdraw-too-much-001"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": \"999999.00\"\n}"
                },
                "url": "{{walletBaseUrl}}/api/v1/wallets/{{walletId}}/withdrawals"
              }
            },
            {
              "name": "Missing Idempotency-Key (400)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": \"10.00\"\n}"
                },
                "url": "{{walletBaseUrl}}/api/v1/wallets/{{walletId}}/deposits"
              }
            }
          ]
        }
      ]
    }
  ]
}
