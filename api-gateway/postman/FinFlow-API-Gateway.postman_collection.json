    {
      "name": "02 Identity via Gateway",
      "description": "Identity Auth + Organisations through gatewayBaseUrl. Run when gateway + identity are up. identity-service Postman collection is left unchanged.",
      "item": [
        {
          "name": "Auth",
          "description": "Public and authenticated identity auth endpoints via the gateway identity route.",
          "item": [
            {
              "name": "0. JWKS (public)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{gatewayBaseUrl}}/.well-known/jwks.json"
              }
            },
            {
              "name": "1. Register",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{gatewayBaseUrl}}/api/v1/auth/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const body = pm.response.json();",
                      "  if (body.token) { pm.collectionVariables.set('verificationToken', body.token); pm.environment.set('verificationToken', body.token); }",
                      "  if (body.profile && body.profile.userId != null) { pm.collectionVariables.set('userId', String(body.profile.userId)); pm.environment.set('userId', String(body.profile.userId)); }",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "1b. Resend verification",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{gatewayBaseUrl}}/api/v1/auth/resend-verification",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.token) { pm.collectionVariables.set('verificationToken', body.token); pm.environment.set('verificationToken', body.token); }",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "2. Verify Email",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{gatewayBaseUrl}}/api/v1/auth/verify-email",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
                }
              }
            },
            {
              "name": "3. Login",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{gatewayBaseUrl}}/api/v1/auth/login",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.accessToken) { pm.collectionVariables.set('accessToken', body.accessToken); pm.environment.set('accessToken', body.accessToken); }",
                      "  if (body.refreshToken) { pm.collectionVariables.set('refreshToken', body.refreshToken); pm.environment.set('refreshToken', body.refreshToken); }",
                      "  if (body.userId != null) { pm.collectionVariables.set('userId', String(body.userId)); pm.environment.set('userId', String(body.userId)); }",
                      "  if (body.permissions) console.log('permissions', body.permissions);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "4. Me",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": "{{gatewayBaseUrl}}/api/v1/users/me"
              }
            },
            {
              "name": "5. Refresh",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{gatewayBaseUrl}}/api/v1/auth/refresh",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.accessToken) { pm.collectionVariables.set('accessToken', body.accessToken); pm.environment.set('accessToken', body.accessToken); }",
                      "  if (body.refreshToken) { pm.collectionVariables.set('refreshToken', body.refreshToken); pm.environment.set('refreshToken', body.refreshToken); }",
                      "  if (body.userId != null) { pm.collectionVariables.set('userId', String(body.userId)); pm.environment.set('userId', String(body.userId)); }",
                      "  if (body.permissions) console.log('permissions', body.permissions);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "6. Forgot Password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{gatewayBaseUrl}}/api/v1/auth/forgot-password",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.token) { pm.collectionVariables.set('resetToken', body.token); pm.environment.set('resetToken', body.token); }",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "7. Reset Password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
