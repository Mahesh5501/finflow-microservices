                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 503', () => pm.response.to.have.status(503));",
                  "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('json'));",
                  "pm.test('Required response fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('object');",
                  "  [\"code\", \"message\", \"status\", \"service\"].forEach(key => pm.expect(body).to.have.property(key));",
                  "});",
                  "pm.test('Error code UPSTREAM_UNAVAILABLE', () => pm.expect(pm.response.json().code).to.eql(\"UPSTREAM_UNAVAILABLE\"));",
                  "pm.test('Error message', () => pm.expect(pm.response.json().message).to.be.a('string').and.not.empty);",
