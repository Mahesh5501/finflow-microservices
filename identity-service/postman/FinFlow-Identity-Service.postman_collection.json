                    "key": "Authorization",
                    "value": "Bearer {{accessToken2}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"token\": \"{{inviteToken}}\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/orgs/invites/accept"
              }
            },
            {
              "name": "List members",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": "{{identityBaseUrl}}/api/v1/orgs/{{orgId}}/members"
              }
            },
            {
              "name": "Change member role",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"role\": \"MEMBER\"\n}"
