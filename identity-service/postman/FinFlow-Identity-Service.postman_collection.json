{
  "info": {
    "name": "FinFlow \u2014 Identity Service",
    "description": "Select environment **FinFlow Local** (shared with Wallet).\n\nHappy path:\n1. Auth: Register \u2192 Verify Email \u2192 Login\n   (If already registered but unverified: skip Register, run **1b. Resend verification** \u2192 Verify Email \u2192 Login)\n2. Optional: Organizations (merchant admins)\n3. Wallet collection \u2014 same {{accessToken}}; shopper APIs need wallet:read / wallet:write on JWT (email verified)\n\nURLs use {{identityBaseUrl}} = http://localhost:18081",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "identityBaseUrl",
      "value": "http://localhost:18081"
    },
    {
      "key": "email",
      "value": "demo@finflow.test"
    },
    {
      "key": "password",
      "value": "password12"
    },
    {
      "key": "memberEmail",
      "value": "operator@finflow.test"
    },
    {
      "key": "memberPassword",
      "value": "password12"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "accessToken2",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "refreshToken2",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "userId2",
      "value": ""
    },
    {
      "key": "orgId",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "inviteToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth (auth.api)",
      "description": "AuthController + JwksController",
      "item": [
        {
          "name": "Public",
          "item": [
            {
              "name": "JWKS",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{identityBaseUrl}}/.well-known/jwks.json"
              }
            },
            {
              "name": "Register",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const body = pm.response.json();",
                      "  if (body.token) { pm.collectionVariables.set('verificationToken', body.token); pm.environment.set('verificationToken', body.token); }",
                      "  if (body.profile && body.profile.userId != null) { pm.collectionVariables.set('userId', String(body.profile.userId)); pm.environment.set('userId', String(body.profile.userId)); }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/auth/register"
              }
            },
            {
              "name": "Resend verification",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.token) { pm.collectionVariables.set('verificationToken', body.token); pm.environment.set('verificationToken', body.token); }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/auth/resend-verification"
              }
            },
            {
              "name": "Verify email",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/auth/verify-email"
              }
            },
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.accessToken) { pm.collectionVariables.set('accessToken', body.accessToken); pm.environment.set('accessToken', body.accessToken); }",
                      "  if (body.refreshToken) { pm.collectionVariables.set('refreshToken', body.refreshToken); pm.environment.set('refreshToken', body.refreshToken); }",
                      "  if (body.userId != null) { pm.collectionVariables.set('userId', String(body.userId)); pm.environment.set('userId', String(body.userId)); }",
                      "  if (body.permissions) console.log('permissions', body.permissions);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/auth/login"
              }
            },
            {
              "name": "Refresh",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.accessToken) { pm.collectionVariables.set('accessToken', body.accessToken); pm.environment.set('accessToken', body.accessToken); }",
                      "  if (body.refreshToken) { pm.collectionVariables.set('refreshToken', body.refreshToken); pm.environment.set('refreshToken', body.refreshToken); }",
                      "  if (body.userId != null) { pm.collectionVariables.set('userId', String(body.userId)); pm.environment.set('userId', String(body.userId)); }",
                      "  if (body.permissions) console.log('permissions', body.permissions);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/auth/refresh"
              }
            },
            {
              "name": "Forgot password",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.token) { pm.collectionVariables.set('resetToken', body.token); pm.environment.set('resetToken', body.token); }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/auth/forgot-password"
              }
            },
            {
              "name": "Reset password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"{{password}}\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/auth/reset-password"
              }
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/auth/logout"
              }
            }
          ]
        },
        {
          "name": "Authenticated",
          "item": [
            {
              "name": "Me",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": "{{identityBaseUrl}}/api/v1/users/me"
              }
            },
            {
              "name": "Change password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{password}}\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/auth/change-password"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Organizations (organization.api)",
      "description": "OrgController \u2014 /api/v1/orgs/**",
      "item": [
        {
          "name": "Org",
          "item": [
            {
              "name": "Create org",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const body = pm.response.json();",
                      "  if (body.orgId != null) { pm.collectionVariables.set('orgId', String(body.orgId)); pm.environment.set('orgId', String(body.orgId)); }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Acme Finance\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/orgs"
              }
            },
            {
              "name": "List my orgs",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": "{{identityBaseUrl}}/api/v1/orgs"
              }
            },
            {
              "name": "Get org",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": "{{identityBaseUrl}}/api/v1/orgs/{{orgId}}"
              }
            }
          ]
        },
        {
          "name": "Members & invites",
          "item": [
            {
              "name": "Invite member",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const body = pm.response.json();",
                      "  if (body.token) { pm.collectionVariables.set('inviteToken', body.token); pm.environment.set('inviteToken', body.token); }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"role\": \"FINANCE_OPERATOR\"\n}"
                },
                "url": "{{identityBaseUrl}}/api/v1/orgs/{{orgId}}/invites"
              }
            },
            {
              "name": "Accept invite (member Bearer)",
              "request": {
                "method": "POST",
                "header": [
