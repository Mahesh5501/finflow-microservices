# Copy to application-local.properties (gitignored). Identity loads it on every start.
# Ethereal: https://ethereal.email   |   Gmail: smtp.gmail.com + App Password

mail.enabled=true
mail.from=you@example.com

spring.mail.host=smtp.ethereal.email
spring.mail.port=587
spring.mail.username=you@example.com
spring.mail.password=secret
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
